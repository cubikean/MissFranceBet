rules_version = '2';

// Règles de sécurité de Pronos Miss. Référence : docs/SPEC.md.
// Principe : tout est refusé sauf ce qui est explicitement autorisé ci-dessous.
// Les tests sont dans tests/rules/ (npm run test:rules).
//
// Modèle : chaque joueur peut créer une party (groupe d'amis) pour une édition ; il en devient
// l'admin (ownerUid). Les autres la rejoignent avec son code. Le super admin (admins/{uid})
// gère toutes les parties. Éditions et candidates sont embarquées dans l'app, pas dans Firestore.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // admins/{uid} est créé à la main dans la console, jamais par le client.
    function isSuperAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function exactKeys(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    // Pseudo : 2 à 20 caractères, sans espace au bord, sans « / », sans caractère de contrôle
    // (retour à la ligne…) ni caractère de format invisible (espace de largeur nulle…) : sinon
    // « Olga » et « Olga » + U+200B passeraient pour deux pseudos différents. (?s) : le point
    // couvre aussi les retours à la ligne. Aligné avec usernameError (src/lib/profile.ts).
    function validName(n) {
      return n is string
        && n.size() >= 2 && n.size() <= 20
        && n.trim() == n
        && !n.matches('(?s).*/.*')
        && !n.matches('(?s).*[\\p{Cc}\\p{Cf}].*');
    }

    // Photo de profil : null, ou data URL WebP/JPEG compressée par l'app (PHOTO_MAX_CHARS dans
    // src/lib/profile.ts). Pas de Storage (plan Blaze) : elle vit dans users/{uid}.
    function validPhoto(x) {
      return x == null
        || (x is string
          && x.size() <= 100000
          && x.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    function usernamePath(lower) {
      return /databases/$(database)/documents/usernames/$(lower);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Code d'invitation : 6 caractères sans ambiguïté (aligné avec CODE_ALPHABET dans src/lib/parties.ts).
    function validCode(c) {
      return c is string && c.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$');
    }

    function validEditionId(e) {
      return e is string && e.matches('^[0-9]{4}$');
    }

    function validPartyName(n) {
      return n is string && n.size() >= 2 && n.size() <= 40 && n.trim() == n;
    }

    function partyPath(p) {
      return /databases/$(database)/documents/parties/$(p);
    }

    function partyData(p) {
      return get(partyPath(p)).data;
    }

    function isMember(p) {
      return signedIn()
        && exists(/databases/$(database)/documents/parties/$(p)/members/$(request.auth.uid));
    }

    function isOwner(p) {
      return signedIn() && partyData(p).ownerUid == request.auth.uid;
    }

    // Admin de la party (son créateur) ou super admin.
    function canManage(p) {
      return isOwner(p) || isSuperAdmin();
    }

    function isOpen(p) {
      return partyData(p).status == 'open';
    }

    // Phases d'une party vivante. Une party supprimée reste en base comme pierre tombale
    // (status 'deleted') : son id ne peut plus être recréé, et plus rien ne s'y écrit.
    function liveStatus(s) {
      return s in ['open', 'closed', 'finished'];
    }

    // Party existante et non supprimée (si elle n'existe pas, get échoue : règle refusée).
    function isLive(p) {
      return liveStatus(partyData(p).status);
    }

    function isLiveAfter(p) {
      return liveStatus(getAfter(partyPath(p)).data.status);
    }

    // Après la fermeture (closed ou finished), les membres et le super admin voient tous les pronos.
    // Avant, personne ne voit ceux des autres : ni l'admin de la party (il joue aussi), ni le super admin.
    // Une party supprimée ne révèle rien (on ne sait plus si ses pronos l'avaient été).
    function isRevealed(p) {
      return (isMember(p) || isSuperAdmin()) && partyData(p).status in ['closed', 'finished'];
    }

    // Identifiant de candidate (format des ids de src/data/editions/*/candidates.json).
    function validCandidateId(x) {
      return x is string && x.matches('^[a-z0-9-]{1,64}$');
    }

    function optionalCandidateId(x) {
      return x == null || validCandidateId(x);
    }

    // null, ou liste de 1 à max ids de candidates distincts. Les règles n'ont pas de boucle :
    // la liste (bornée) est jointe puis contrôlée d'un coup par une regex. Redécoupée, elle doit
    // redonner la liste d'origine : chaque élément est une chaîne (join convertit les nombres)
    // sans virgule cachée (sinon sa longueur serait illimitée).
    function optionalCandidateList(l, max) {
      return l == null
        || (l is list
          && l.size() >= 1 && l.size() <= max
          && l.toSet().size() == l.size()
          && l.join(',').matches('^[a-z0-9-]{1,64}(,[a-z0-9-]{1,64})*$')
          && l.join(',').split(',') == l);
    }

    // results/live après écriture (fusion comprise) : champs connus, typés et bornés.
    function validResults(d) {
      return d.keys().hasOnly(['top15', 'top5', 'winner', 'firstRunnerUp', 'secondRunnerUp', 'updatedAt'])
        && optionalCandidateList(d.get('top15', null), 15)
        && optionalCandidateList(d.get('top5', null), 5)
        && optionalCandidateId(d.get('winner', null))
        && optionalCandidateId(d.get('firstRunnerUp', null))
        && optionalCandidateId(d.get('secondRunnerUp', null))
        && d.updatedAt == request.time;
    }

    // ---------- Super admin ----------

    match /admins/{uid} {
      // Chacun peut seulement savoir s'il est super admin lui-même (useIsSuperAdmin).
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ---------- Profils et pseudos ----------

    match /users/{uid} {
      // Lecture par uid seulement (on connaît l'uid de ses partenaires de party) : impossible
      // de lister tous les profils et leurs photos, sauf pour le super admin (sauvegarde).
      allow get: if signedIn();
      allow list: if isSuperAdmin();

      // Le pseudo doit être réservé dans le même batch/transaction (usernames/{lower}).
      allow create: if isSelf(uid)
        && exactKeys(request.resource.data, ['displayName', 'displayNameLower', 'photo', 'createdAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.displayNameLower == request.resource.data.displayName.lower()
        && validPhoto(request.resource.data.photo)
        && request.resource.data.createdAt == request.time
        && getAfter(usernamePath(request.resource.data.displayNameLower)).data.uid == uid;

      // Changer de pseudo = réserver le nouveau ET libérer l'ancien dans la même écriture.
      // 'emoji' : ancien champ des premiers profils, qu'on peut seulement laisser tel quel ou retirer.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'displayNameLower', 'photo', 'emoji'])
        && !request.resource.data.diff(resource.data).addedKeys().hasAny(['emoji'])
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(['emoji'])
        && validName(request.resource.data.displayName)
        && request.resource.data.displayNameLower == request.resource.data.displayName.lower()
        && validPhoto(request.resource.data.get('photo', null))
        && (
          request.resource.data.displayNameLower == resource.data.displayNameLower
          || (
            getAfter(usernamePath(request.resource.data.displayNameLower)).data.uid == uid
            && !existsAfter(usernamePath(resource.data.displayNameLower))
          )
        );

      allow delete: if false;
    }

    match /usernames/{lower} {
      // get seulement, et seulement d'un pseudo libre ou du sien : savoir si un pseudo est pris
      // (refus) sans pouvoir en tirer l'uid de son propriétaire, ni lister tout le monde.
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;

      // create échoue si le document existe déjà (ce serait un update) : pseudo unique.
      allow create: if signedIn()
        && exactKeys(request.resource.data, ['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.displayNameLower == lower;

      allow update: if false;

      // Libération de l'ancien pseudo lors d'un changement de pseudo.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.displayNameLower != lower;
    }

    // ---------- Codes d'invitation ----------

    // partyCodes/{code} -> { partyId, editionId }. L'id du document EST le code : unicité garantie
    // (create échoue s'il existe). get seulement, pour rejoindre : impossible de lister les codes.
    match /partyCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      // Écrit dans le même batch que la party : à sa création (par son créateur), ou quand son
      // admin change le code (régénération). Le code doit être celui de la party après écriture.
      allow create: if signedIn()
        && validCode(code)
        && exactKeys(request.resource.data, ['partyId', 'editionId'])
        && request.resource.data.partyId is string
        && getAfter(partyPath(request.resource.data.partyId)).data.code == code
        && getAfter(partyPath(request.resource.data.partyId)).data.editionId == request.resource.data.editionId
        && (
          (!exists(partyPath(request.resource.data.partyId))
            && getAfter(partyPath(request.resource.data.partyId)).data.ownerUid == request.auth.uid)
          || (exists(partyPath(request.resource.data.partyId))
            && canManage(request.resource.data.partyId)
            && isLive(request.resource.data.partyId)
            && partyData(request.resource.data.partyId).code != code)
        );

      allow update: if false;

      // Libéré, dans le même batch, quand la party est supprimée (pierre tombale) ou que son code
      // change ; par son admin ou le super admin. Le code libéré peut resservir à une autre party.
      allow delete: if isSuperAdmin()
        || (canManage(resource.data.partyId)
          && (getAfter(partyPath(resource.data.partyId)).data.status == 'deleted'
            || getAfter(partyPath(resource.data.partyId)).data.code != code));
    }

    // Requête collection group « mes adhésions » (members où uid == moi).
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Parties ----------

    match /parties/{p} {
      // Une party supprimée (pierre tombale) n'est plus lisible que par le super admin (sauvegarde).
      allow get: if (isMember(p) && (resource == null || liveStatus(resource.data.status))) || isSuperAdmin();
      allow list: if isSuperAdmin();

      // Création : le créateur devient admin et membre ; le code est réservé dans le même batch.
      // create ne s'applique qu'à un document absent : la pierre tombale d'une party supprimée
      // empêche de recréer son id (et de récupérer ses adhésions, son journal et ses pronos).
      allow create: if signedIn()
        && exactKeys(request.resource.data,
             ['editionId', 'name', 'ownerUid', 'code', 'status', 'eventCount', 'createdAt'])
        && validEditionId(request.resource.data.editionId)
        && validPartyName(request.resource.data.name)
        && request.resource.data.ownerUid == request.auth.uid
        && validCode(request.resource.data.code)
        && request.resource.data.status == 'open'
        && request.resource.data.eventCount == 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/partyCodes/$(request.resource.data.code)).data.partyId == p
        && existsAfter(/databases/$(database)/documents/parties/$(p)/members/$(request.auth.uid));

      // Admin de la party ou super admin : renommer, changer de phase, transmettre le rôle d'admin.
      // Changer de phase ou d'admin (jamais les deux à la fois) incrémente eventCount et écrit
      // events/{n} dans le même batch. Le nouvel admin doit être membre.
      // Changer de code : seul champ modifié, le nouveau partyCodes/{code} est créé et l'ancien
      // supprimé dans le même batch (l'ancien lien d'invitation cesse de marcher).
      allow update: if canManage(p)
        && liveStatus(resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
        && validCode(request.resource.data.code)
        && getAfter(/databases/$(database)/documents/partyCodes/$(request.resource.data.code)).data.partyId == p
        && !existsAfter(/databases/$(database)/documents/partyCodes/$(resource.data.code));

      allow update: if canManage(p)
        && liveStatus(resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'ownerUid', 'eventCount'])
        && validPartyName(request.resource.data.name)
        && liveStatus(request.resource.data.status)
        && (
          // renommage seul (le nom doit changer : pas d'écriture à vide)
          (request.resource.data.name != resource.data.name
            && request.resource.data.status == resource.data.status
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.eventCount == resource.data.eventCount)
          // changement de phase
          || (request.resource.data.status != resource.data.status
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.eventCount == resource.data.eventCount + 1
            && existsAfter(/databases/$(database)/documents/parties/$(p)/events/$(string(request.resource.data.eventCount))))
          // transmission du rôle d'admin
          || (request.resource.data.ownerUid != resource.data.ownerUid
            && request.resource.data.status == resource.data.status
            && request.resource.data.eventCount == resource.data.eventCount + 1
            && exists(/databases/$(database)/documents/parties/$(p)/members/$(request.resource.data.ownerUid))
            && existsAfter(/databases/$(database)/documents/parties/$(p)/members/$(request.resource.data.ownerUid))
            && existsAfter(/databases/$(database)/documents/parties/$(p)/events/$(string(request.resource.data.eventCount))))
        );

      // Suppression : admin de la party ou super admin (double confirmation dans l'interface).
      // Pierre tombale : le document reste, seul son statut passe à 'deleted' (avec deletedAt),
      // dans le même batch que la libération du code et la suppression des adhésions (celle de
      // l'admin au moins est vérifiée ici ; l'app retire toutes les autres).
      allow update: if canManage(p)
        && liveStatus(resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt'])
        && request.resource.data.status == 'deleted'
        && request.resource.data.deletedAt == request.time
        && !existsAfter(/databases/$(database)/documents/partyCodes/$(resource.data.code))
        && !existsAfter(/databases/$(database)/documents/parties/$(p)/members/$(resource.data.ownerUid));

      // Jamais de suppression réelle : elle libérerait l'id, qu'on pourrait recréer pour
      // récupérer les adhésions, le journal et les pronos restés en base.
      allow delete: if false;

      // ---------- Journal ----------

      // events/{n} : création seule, cohérente avec la party écrite dans le même batch.
      // type 'status' : from/to = phases ; type 'owner' : from/to = uid de l'ancien et du nouvel admin.
      match /events/{n} {
        allow read: if (isMember(p) && isLive(p)) || isSuperAdmin();
        allow create: if canManage(p)
          && isLiveAfter(p)
          && exactKeys(request.resource.data, ['type', 'from', 'to', 'by', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.from != request.resource.data.to
          && string(getAfter(partyPath(p)).data.eventCount) == n
          && (
            (request.resource.data.type == 'status'
              && request.resource.data.from == partyData(p).status
              && request.resource.data.to == getAfter(partyPath(p)).data.status)
            || (request.resource.data.type == 'owner'
              && request.resource.data.from == partyData(p).ownerUid
              && request.resource.data.to == getAfter(partyPath(p)).data.ownerUid)
          );
        allow update, delete: if false;
      }

      // ---------- Membres ----------

      match /members/{uid} {
        // Un membre voit les autres membres (et qui a déjà pronostiqué). Aucun code n'y est stocké.
        allow get: if isSelf(uid) || (isMember(p) && isLive(p)) || isSuperAdmin();
        allow list: if (isMember(p) && isLive(p)) || isSuperAdmin();

        // Deux façons d'entrer : créer la party (dans le même batch), ou prouver qu'on connaît
        // le code via joinProofs/{uid}, écrit dans le même batch puis supprimé par le client.
        allow create: if isSelf(uid)
          && exactKeys(request.resource.data, ['uid', 'editionId', 'joinedAt', 'hasPicked'])
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == request.time
          // false à la première arrivée ; true si je reviens et que mon prono est resté.
          && request.resource.data.hasPicked == exists(/databases/$(database)/documents/parties/$(p)/picks/$(uid))
          && request.resource.data.editionId == getAfter(partyPath(p)).data.editionId
          && (
            (!exists(partyPath(p)) && getAfter(partyPath(p)).data.ownerUid == uid)
            || (isLive(p)
            && getAfter(/databases/$(database)/documents/parties/$(p)/joinProofs/$(uid)).data.code
               == partyData(p).code)
          );

        // Seul changement possible : hasPicked passe à true, dans le batch d'un prono.
        allow update: if isSelf(uid)
          && isOpen(p)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasPicked'])
          && request.resource.data.hasPicked == true
          && existsAfter(/databases/$(database)/documents/parties/$(p)/picks/$(uid));

        // Quitter (soi-même) ou être retiré (par l'admin ou le super admin). L'admin ne peut ni
        // partir ni être retiré : il transmet d'abord son rôle. L'admin s'entend avant ET après
        // l'écriture : impossible de transmettre le rôle et de retirer le nouvel admin (ou de
        // partir) dans le même batch. Exception : la suppression de la party (pierre tombale), où
        // toutes les adhésions partent dans le même batch ; une adhésion restée sous une party
        // supprimée ou absente peut toujours être retirée.
        allow delete: if (isSelf(uid) || canManage(p))
          && (
            !existsAfter(partyPath(p))
            || getAfter(partyPath(p)).data.status == 'deleted'
            || (uid != partyData(p).ownerUid && uid != getAfter(partyPath(p)).data.ownerUid)
          );
      }

      // Preuve temporaire du code, écrite avec l'adhésion puis supprimée aussitôt par le client.
      // Illisible par tous, auteur compris.
      match /joinProofs/{uid} {
        allow read: if false;
        // Seulement sous une party existante et non supprimée, par un non-membre (qui rejoint).
        allow create, update: if isSelf(uid)
          && isLive(p)
          && !isMember(p)
          && exactKeys(request.resource.data, ['code'])
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 64;
        allow delete: if isSelf(uid) || isSuperAdmin();
      }

      // ---------- Résultats (saisis par l'admin de la party) ----------

      // Saisie seulement pendant l'émission (closed) : une fois la soirée terminée, corriger le
      // podium (donc les trophées) oblige à revenir à 'closed', ce qui est journalisé.
      match /results/{docId} {
        allow read: if (isMember(p) && isLive(p)) || isSuperAdmin();
        allow write: if canManage(p)
          && docId == 'live'
          && partyData(p).status == 'closed'
          && validResults(request.resource.data);
      }

      // ---------- Pronos ----------

      // Écriture d'un prono (création ou changement d'avis) avec le numéro de changement n.
      // Le document pickHistory/{uid}_{n} doit être écrit dans le même batch, avec les mêmes
      // valeurs et le même horodatage serveur. La candidate est vérifiée côté client contre les
      // données embarquées ; un id inventé ne peut de toute façon gagner aucun trophée.
      function validPickWrite(party, who, n) {
        let d = request.resource.data;
        let h = getAfter(/databases/$(database)/documents/parties/$(party)/pickHistory/$(who + '_' + string(n))).data;
        return isMember(party)
          && isOpen(party)
          && exactKeys(d, ['candidateId', 'changeCount', 'updatedAt'])
          && d.candidateId is string
          && d.candidateId.matches('^[a-z0-9-]{1,64}$')
          && d.changeCount is int
          && d.changeCount == n
          && d.updatedAt == request.time
          && h.uid == who
          && h.candidateId == d.candidateId
          && h.changeCount == n
          && h.at == request.time;
      }

      match /picks/{uid} {
        allow get: if isSelf(uid) || isRevealed(p);
        allow list: if isRevealed(p);

        allow create: if isSelf(uid) && validPickWrite(p, uid, 1);
        allow update: if isSelf(uid) && validPickWrite(p, uid, resource.data.changeCount + 1);
        allow delete: if false;
      }

      match /pickHistory/{historyId} {
        // Son propre historique toujours ; celui des autres seulement après la fermeture.
        allow get, list: if isRevealed(p)
          || (signedIn() && resource.data.uid == request.auth.uid);

        // Création seulement, id = {uid}_{changeCount}, cohérente avec le prono écrit
        // dans le même batch (même candidate, même compteur, même request.time).
        allow create: if signedIn()
          && exactKeys(request.resource.data, ['uid', 'candidateId', 'changeCount', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.changeCount is int
          && request.resource.data.changeCount >= 1
          && historyId == request.auth.uid + '_' + string(request.resource.data.changeCount)
          && request.resource.data.at == request.time
          && isMember(p)
          && isOpen(p)
          && getAfter(/databases/$(database)/documents/parties/$(p)/picks/$(request.auth.uid)).data.changeCount == request.resource.data.changeCount
          && getAfter(/databases/$(database)/documents/parties/$(p)/picks/$(request.auth.uid)).data.candidateId == request.resource.data.candidateId
          && getAfter(/databases/$(database)/documents/parties/$(p)/picks/$(request.auth.uid)).data.updatedAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
