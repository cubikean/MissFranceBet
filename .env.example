# Configuration Firebase (console Firebase > Paramètres du projet > Tes applications > SDK setup).
# Copie ce fichier en .env.local puis remplis les valeurs. Elles finissent dans le bundle :
# ce ne sont pas des secrets, la sécurité repose sur firestore.rules.

VITE_FIREBASE_API_KEY=
# IMPORTANT : mets le domaine d'hébergement (missfrancebet.web.app), pas missfrancebet.firebaseapp.com,
# sinon la connexion Google casse sur Safari iOS (cookies tiers).
VITE_FIREBASE_AUTH_DOMAIN=missfrancebet.web.app
VITE_FIREBASE_PROJECT_ID=missfrancebet
VITE_FIREBASE_STORAGE_BUCKET=missfrancebet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = l'app parle aux émulateurs locaux (auth 9099, firestore 8080) au lieu du vrai projet.
# En local avec émulateurs, les valeurs ci-dessus peuvent rester factices
# (projectId doit alors valoir demo-pronos-miss).
VITE_USE_EMULATORS=false

# App Check (gratuit) contre les bots : clé reCAPTCHA Enterprise de type Web, à score
# (console Google Cloud > Fraud Defense), enregistrée dans console Firebase > App Check.
# Vide = App Check désactivé. VITE_APPCHECK_DEBUG=true seulement en local contre le vrai projet.
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG=false
